{
  "schemaVersion": 1,
  "id": "armourbundles",
  "version": "${version}",
  "name": "Armour Bundles",
  "description": "Adds an item that allows quick-swapping between armour sets",
  "authors": [
    "Auroali"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/armour-bundles",
    "sources": "https://github.com/Auroali/armour-bundles",
    "issues": "https://github.com/Auroali/armour-bundles/issues"
  },
  "license": "MIT",
  "icon": "assets/armourbundles/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.auroali.armourbundles.ArmourBundles"
    ],
    "client": [
      "com.auroali.armourbundles.ArmourBundlesClient"
    ],
    "fabric-datagen": [
      "com.auroali.armourbundles.ArmourBundlesDataGenerator"
    ],
    "dfuhooks-init": [
      "com.auroali.armourbundles.datafixer.ABDatafixer"
    ]
  },
  "mixins": [
    "armourbundles.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "~26.1",
    "java": ">=25",
    "fabric-api": "*",
    "dfuhooks": ">=1.0.0"
  }
}
